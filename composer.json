{
    "name": "survos/ark-bundle",
    "description": "Symfony bundle for ARK identifier minting and resolution",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "ark",
        "identifier",
        "noid",
        "resolver",
        "archival"
    ],
    "autoload": {
        "psr-4": {
            "Survos\\ArkBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\ArkBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/dbal": "^3.9||^4.2",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/uid": "^8.1",
        "daniel-km/noid": "^1.4",
        "twig/twig": "^3.21",
        "survos/kit-bundle": "^2.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "api-platform/core": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "api-platform/core": "Exposes ArkBinding as an ApiResource with collection/item endpoints.",
        "survos/field-bundle": "Registers ArkBinding in the admin navbar via #[EntityMeta].",
        "survos/jsonl-bundle": "Enables ark:export --output and ark:import --input with .jsonl/.jsonl.gz files."
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "symfony": {
            "require": "^8.0"
        }
    }
}